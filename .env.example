# .env.example: what `npm run demo:live` reads. Values are never committed; this file holds names only.
#
# demo:live does not read a .env from this repository. Each agent keeps its own credentials directory, outside
# the repository, holding three files:
#   .env            NEAR_INTENTS_AGENT_API_KEY=<the Agent API key this agent uses>
#                   NEAR_INTENTS_AGENT_API_URL=<the Agent API base URL> (read from the seller's .env only)
#   .grant-token    the agent's Agent Connect grant token (one line)
#   aa-state.json   {"agent_id": "<the agent's Agent Connect id>", ...}
# These are local paths on your machine, never URLs: the files are secrets and are not on GitHub.
# The owner-side scripts that create the agents and sign their policies: https://github.com/jcarbonnell/nova (paid-handoff/)
# Point demo:live at the two directories (defaults shown):
SELLER_DIR=~/near/nova/paid-handoff
FOLLOWER_DIR=~/near/nova/paid-handoff/follower-1

# Optional (defaults in brackets). Export them in your shell, e.g. `export NEAR_ARCHIVAL_MIN_INTERVAL_MS=1500`.
AGENT_API_BASE_URL=                 # the Agent API base URL [NEAR_INTENTS_AGENT_API_URL in the seller's .env]
NEAR_RPC_URL=                       # [https://rpc.mainnet.near.org]
NEAR_ARCHIVAL_RPC_URL=              # used to verify the payment [https://archival-rpc.mainnet.fastnear.com]
NEAR_ARCHIVAL_MIN_INTERVAL_MS=      # pacing of archival requests, ms [1200]
ENTRY_INTERVAL_MS=                  # time between journal entries, ms [60000]
HOSTILE_PROCEEDS=                   # listing #99's proceeds account: must exist, outside the follower's policy [wrap.near]
PREFLIGHT_PAYMENT_DIR=              # an earlier run whose payment P11 re-verifies [state/attempt2; skipped if absent]