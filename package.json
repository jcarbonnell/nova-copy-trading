{
  "name": "nova-copy-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Confidential trade signals between AI agents: NEAR Intents Agent Connect + NOVA. Technical demo, not investment advice.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test:vendor": "cd src/vendor && tsx test-nova-agent-connect.ts && node mutate-nova-agent-connect.mjs",
    "test:payment": "tsx test/verify-payment.test.ts && node test/mutate-verify-payment.mjs",
    "test:chain": "tsx test/near-chain.test.ts && node test/mutate-near-chain.mjs",
    "test:journal": "tsx test/journal.test.ts && node test/mutate-journal.mjs",
    "test:pnl": "tsx test/pnl.test.ts && node test/mutate-pnl.mjs",
    "test:listing": "tsx test/listing.test.ts && node test/mutate-listing.mjs",
    "test:feed": "tsx test/verify-feed.test.ts && node test/mutate-verify-feed.mjs",
    "test:membership": "tsx test/membership.test.ts && node test/mutate-membership.mjs",
    "test:live": "tsx test/live-feed.test.ts && node test/mutate-live-feed.mjs",
    "test:ledger": "tsx test/ledger-file.test.ts && node test/mutate-ledger-file.mjs",
    "test:reader": "tsx test/nova-reader.test.ts && node test/mutate-nova-reader.mjs",
    "test:members": "tsx test/member-ops.test.ts && node test/mutate-member-ops.mjs",
    "test:writer": "tsx test/journal-writer.test.ts && node test/mutate-journal-writer.mjs",
    "test:builder": "tsx test/listing-builder.test.ts && node test/mutate-listing-builder.mjs",
    "test:service": "tsx test/seller-service.test.ts && node test/mutate-seller-service.mjs",
    "test:pending": "tsx test/pending-file.test.ts && node test/mutate-pending-file.mjs",
    "test": "npm run typecheck && npm run test:vendor && npm run test:payment && npm run test:chain && npm run test:journal && npm run test:pnl && npm run test:listing && npm run test:feed && npm run test:membership && npm run test:live && npm run test:ledger && npm run test:reader && npm run test:members && npm run test:writer && npm run test:builder && npm run test:service && npm run test:pending"
  },
  "dependencies": {
    "@near-intents-agent-api/sdk": "0.7.2",
    "nova-sdk-js": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}